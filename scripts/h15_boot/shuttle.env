# shellcheck shell=bash
# Settings for running the h15_boot scripts ON a shuttle (the host wired to the
# board: board link 10.0.0.2 <-> 10.0.0.1, TFTP server, FTDI serial console).
# Source, don't run:   source scripts/h15_boot/shuttle.env
#
# Every value can be overridden by exporting it before sourcing.

# Board on the shuttle's board link.
export TARGET=${TARGET:-root@10.0.0.1}

# Dedicated key for the board, created and installed by vpu_board_key.sh. A fresh
# flash wipes the board's authorized_keys, and shared shuttle accounts often hold
# several keys, so the scripts use this one explicitly instead of ssh's default.
export H15_KEY=${H15_KEY:-$HOME/.ssh/h15_board_ed25519}

# ProxyCommand=none: some shuttles proxy all ssh through sss_ssh_knownhostsproxy,
# which breaks connections to 10.0.0.1. Host keys change on every flash and boards
# share 10.0.0.1, so known_hosts is skipped.
export SSH_OPTS=${SSH_OPTS:-"-o ProxyCommand=none -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10 -o BatchMode=yes -i $H15_KEY -o IdentitiesOnly=yes"}

# Release store and where releases are staged on the shuttle for TFTP.
export YSTOR=${YSTOR:-hailo@192.168.12.21}
export YSTOR_BKC=${YSTOR_BKC:-/mnt/ystor/bkc}
export H15_IMAGES=${H15_IMAGES:-/local/users/$USER/h15_images}

# A53 console. Prefer the board's own FTDI by id (SBC_H15L / SBC_H15H); the ttyUSB
# number depends on what else is plugged in (on had-1067 it's ttyUSB3, next to an
# unrelated FT232R on ttyUSB0). Fallback: debug board FT4232H port 3.
if [ -z "${H15_TTY:-}" ]; then
    H15_TTY=$(ls /dev/serial/by-id/*SBC_H15* 2>/dev/null | head -1)
    H15_TTY=${H15_TTY:-/dev/ttyUSB3}
fi
export H15_TTY

# Work dir for build_bundle.sh (SDKs are ~3 GB per release/machine).
export H15_WORK=${H15_WORK:-/local/users/$USER/h15_bundle_work}

# Per-run log directories (logs=yes). In remote mode the laptop uses its own
# $H15_RUNS (default ~/h15_vpu_runs); this one applies when the skill runs here.
export H15_RUNS=${H15_RUNS:-$HOME/h15_vpu_runs}
